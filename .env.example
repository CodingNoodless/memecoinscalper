# Copy this file to .env and fill in local credentials. Do not commit .env.
RUGCHECK_API_KEY=
JUPITER_API_KEY=
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=180

# Jupiter quote-only paper fills require an API key. No wallet is loaded or used.
PAPER_STARTING_BALANCE=100
TRADE_SIZE_USD=50
PAPER_EXECUTION_SLIPPAGE_BPS=50
PAPER_NETWORK_FEE_USD=0.02
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT_OF_BALANCE=0.05
MAX_DAILY_LOSS_PCT=0.03

# All strategy thresholds are experimental and should be calibrated out of sample.
MAX_NEW_TOKEN_AGE_HOURS=2
MIN_NEW_POOL_AGE_MINUTES=15
TOKEN_RETRY_COOLDOWN_SECONDS=21600
MAX_CANDIDATE_AGE_SECONDS=300
ENTRY_WATCH_MAX_SECONDS=180
ENTRY_WATCH_RECHECK_SECONDS=60
ENTRY_WATCH_POLL_INTERVAL_SECONDS=3
ENTRY_PULLBACK_BAND_PCT=0.01
ENTRY_RECLAIM_CONFIRMATION_PCT=0.002
ACTIVE_TRADE_POLL_INTERVAL_SECONDS=1.25
JUPITER_MIN_REQUEST_INTERVAL_SECONDS=1.05
MIN_LIQUIDITY_USD=5000
MIN_TXNS_5M=10
MIN_SELECTION_SCORE=60
# Reject sharp 5-minute selloffs and highly extended pumps. Experimental gates.
MIN_ENTRY_PRICE_CHANGE_5M_PCT=-15
MAX_ENTRY_PRICE_CHANGE_5M_PCT=40
# RugCheck normalized scores above 40 are rejected; danger/critical risks always fail.
MAX_RUGCHECK_SCORE=40
# LP lock risk is included in RugCheck's score; avoid double-rejecting low-lock tokens in paper sampling.
MIN_LP_LOCKED_PCT=0
STOP_LOSS_PCT=-0.20
TRAILING_STOP_ACTIVATION=0.10
TRAILING_STOP_PCT=0.12
TRAILING_STOP_FLOOR_PCT=0.01
MAX_HOLD_HOURS=1
# Hard-capped at 3% even if a legacy .env has a larger value.
MAX_ENTRY_ROUNDTRIP_LOSS_PCT=0.03
QUOTE_SHOCK_CONFIRMATION_PCT=0.40
QUOTE_CONFIRMATION_TOLERANCE_PCT=0.12
MARKET_QUOTE_DIVERGENCE_ALERT_PCT=0.30
CHART_MIN_CANDLES=15
CHART_MAX_STALENESS_SECONDS=180
CHART_MAX_ENTRY_3M_RETURN_PCT=0.20
CHART_MAX_ENTRY_CANDLE_RETURN_PCT=0.15
CHART_MAX_ENTRY_UPPER_WICK_PCT=0.20
CHART_MAX_EMA_EXTENSION_PCT=0.20
CHART_REQUEST_MIN_INTERVAL_SECONDS=8
QUOTE_CHART_FAST_EMA_PERIOD=3
QUOTE_CHART_SLOW_EMA_PERIOD=8
QUOTE_CHART_BEARISH_CONFIRMATIONS=3
RUGCHECK_MIN_REQUEST_INTERVAL_SECONDS=1.1
RUGCHECK_HTTP_TIMEOUT_SECONDS=20
PAPER_OBSERVATION_INTERVAL_SECONDS=15
